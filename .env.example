# ══════════════════════════════════════════════
#  ATe 환경변수 템플릿
# ══════════════════════════════════════════════
#
# 사용법:
#   cp .env.example .env
#   .env 내용 수정 후 docker compose up

# ────────────────
# MongoDB
# ────────────────
DB_USER=ate_user
DB_PASSWORD=ate_pass_change_me
DB_NAME=ate_db

# ────────────────
# Backend
# ────────────────
SECRET_KEY=your-secret-key-change-this-in-production

# ────────────────
# AI 서비스 (AI팀 별도 FastAPI 서버)
# ────────────────
# AI팀이 띄운 FastAPI 서버 주소
AI_SERVICE_URL=http://localhost:9000
AI_SERVICE_TIMEOUT=60

# AI팀 미연결 상태에서 데모하려면 true (mock 응답 반환)
AI_SERVICE_MOCK=false

# ────────────────
# AI 엔진 (AI팀이 자체 사용)
# ────────────────
OPENAI_API_KEY=sk-your-openai-key

# ────────────────
# v2 파일 업로드/내보내기
# ────────────────
UPLOAD_DIR=/tmp/ate-uploads
MAX_UPLOAD_SIZE_MB=50
EXPORT_DIR=/tmp/ate-exports
